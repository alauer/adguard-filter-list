// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Adguard List Builder Dev Container",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",

	// Forward host env vars into the container so tools (gh CLI, curl, etc.)
	// can authenticate to GitHub. ${localEnv:...} is resolved by VS Code at
	// container creation from the host's environment.
	"containerEnv": {
		"GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
		"GH_TOKEN": "${localEnv:GITHUB_TOKEN}"
	},

	"features": {
		"ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      		"packages": ["npm","python3-pip","git"]
    	},
		"ghcr.io/wxw-matt/devcontainer-features/command_runner:0": {
			"command1": ["npm i -g @adguard/hostlist-compiler@v1.0.39"]
		},
		"ghcr.io/devcontainers/features/terraform:1": {
			"version": "1.13.3"
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "pip3 install -r requirements.txt --break-system-packages",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
