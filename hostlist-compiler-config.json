{
  "name": "alauer/adguard-filter-list",
  "description": "DNS block list that can be used for AdGuardHome. (Does not work with Pi-hole)",
  "homepage": "https://github.com/alauer/adguard-filter-list",
  "license": "GPLv3",
  "sources": [
    {
      "name": "Dandelion Sprout's Anti-Malware List",
      "source": "https://adguardteam.github.io/HostlistsRegistry/assets/filter_12.txt",
      "type": "adblock"
    },
    {
      "name": "HaGeZi's Light Blocklist",
      "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/light.txt",
      "type": "adblock"
    },
    {
      "name": "HaGeZi's Threat Intelligence Feeds DNS Blocklist",
      "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/tif.medium.txt",
      "type": "adblock"
    },
    {
      "name": "uBlock filters – Privacy",
      "source": "https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/privacy.txt",
      "type": "adblock"
    },
    {
      "name": "uBlock filters – Resource abuse",
      "source": "https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/resource-abuse.txt",
      "type": "adblock"
    },
    {
      "name": "uBlock filters – Unbreak",
      "source": "https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/unbreak.txt",
      "type": "adblock"
    }
  ],
  "transformations": [
    "RemoveComments",
    "Validate",
    "Deduplicate",
    "TrimLines",
    "InsertFinalNewLine",
    "RemoveEmptyLines"
  ]
}
